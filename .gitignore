# KSPDOWA — Git Ignore
# =============================================================
# CRITICAL: Never commit database credentials or secrets.
# =============================================================

# Database secret file (copy from db.secret.example.php and fill in credentials)
public_html/config/db.secret.php

# Mail secret file (copy from mail.secret.example.php and fill in credentials)
public_html/config/mail.secret.php

# Razorpay secret file (copy from razorpay.secret.example.php and fill in credentials)
public_html/config/razorpay.secret.php

# Local mail log (safe 'log' mail driver output -- can contain temp passwords)
/storage/

# Environment/local config overrides
.env
.env.local
*.local.php

# PHP error logs
*.log
error_log

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Uploaded files (do not commit user content to source control)
public_html/uploads/members/
!public_html/uploads/members/photos/.htaccess
public_html/uploads/documents/
public_html/uploads/grievances/
public_html/uploads/news/
public_html/uploads/temp/
public_html/uploads/receipts/
# public_html/assets/images/office-bearers/ is tracked for official photos

# One-off debug / diagnostic scripts (never deploy to production)
public_html/_check_*.php
public_html/_reset_*.php
public_html/_set_admin_password.php

# Composer vendor (if added later)
vendor/
composer.lock

# Node (should not be used per spec, but guard against accidental addition)
node_modules/
package-lock.json

# OS files
.DS_Store
desktop.ini

# Codebase Memory MCP cache
.codebase-memory/
