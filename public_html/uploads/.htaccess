# KSPDOWA — uploads/ directory
# Block direct HTTP access to all files. Uploaded files must be
# served exclusively through an authorization-checked PHP endpoint.
# Also disable PHP execution to prevent uploaded script execution.
#
# Apache 2.4 (mod_authz_core) uses "Require all denied"; the older
# "Order/Deny" syntax is only honored if mod_access_compat is loaded and
# is otherwise silently ignored, which would leave this directory
# unprotected. Both forms are declared so this works on either version.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>

# Disable PHP execution even if the deny-all is bypassed
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable CGI execution
Options -ExecCGI
AddType text/plain .php .php3 .php4 .php5 .phtml .phar
